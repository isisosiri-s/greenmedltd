ErrorDocument 404 /404.html

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>

# Temporarily disable the Russian (/ru) section — return 404 for all pages under it
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^ru(/.*)?$ - [R=404,NC,L]
</IfModule>

# Hotlink protection: block other websites from embedding our images
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?greenmedltduk\.com [NC]
RewriteRule \.(png|jpe?g|gif|webp|svg)$ - [F,NC]
</IfModule>
